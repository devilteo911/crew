#!/bin/sh
# crew [dir]       opens a terminal with a Claude Code session for every profile in ~/.claude/crew/*.md
# crew run <name>  starts the one session of that profile, here: the single place that builds the claude command
# `run` is the subcommand only as an exact first argument; `crew ./run` opens the crew in a directory named run.
# File name = session name; <name>.md = appended system prompt; optional <name>.model = --model value.
# optional <name>.worktree (contents ignored) = in a git repo, the session works in its own worktree, and nowhere else.
set -e
self=$(readlink "$0" || echo "$0")   # ~/.local/bin/crew is a symlink (install.sh)
root=$(CDPATH='' cd -- "$(dirname -- "$self")/.." && pwd)
self="$root/bin/crew"
crewdir="${CREW_DIR:-$HOME/.claude/crew}"
# absolute: crew run may cd into a worktree before its exec, and each terminal cds into the project first
case $crewdir in /*) ;; *) crewdir="$PWD/$crewdir" ;; esac

# git fetch in <dir>, bounded to 5 s (macOS has no timeout(1)); the fetch's status, non-zero when killed.
# The group keeps the shell's own "Terminated" for the killed fetch off stderr.
fetch5() { # <dir>
  rc=0
  {
    # ponytail: 5 s watchdog; raise it if slow links matter
    GIT_TERMINAL_PROMPT=0 git -C "$1" fetch -q >/dev/null 2>&1 & p=$!
    (sleep 5; kill "$p") >/dev/null 2>&1 & w=$!
    wait "$p" || rc=$?
    kill "$w" 2>/dev/null || true
    wait "$w" || true
  } 2>/dev/null
  return "$rc"
}

# Keeps the clone the curl installer manages up to date, once per launch (CREW_NO_UPDATE=1 skips it).
# Every git call sits in a condition: a failed update warns once and the launch goes on.
update() {
  [ "$root" = "$HOME/.local/share/crew" ] || return 0
  [ -z "${CREW_NO_UPDATE:-}" ] || return 0
  old=$(git -C "$root" rev-parse HEAD 2>/dev/null) || return 0
  ok=0
  # Only the fetch is bounded; the ff merge is local, and killing it halfway could leave a half-checked-out tree.
  if fetch5 "$root" && git -C "$root" merge --ff-only -q '@{u}' >/dev/null 2>&1; then ok=1; fi
  if [ "$ok" -eq 0 ]; then
    echo "crew: could not update $root (offline, diverged or local changes), starting $(cat "$root/VERSION" 2>/dev/null || echo unknown) as is" >&2
  fi
  if [ "$(git -C "$root" rev-parse HEAD 2>/dev/null)" = "$old" ]; then return 0; fi
  # The plugin cache is keyed by version: refresh it only when this pull changed the version and crew@crew is installed.
  # Never marketplace add (it can repoint a crew marketplace registered from another directory); stdin from /dev/null, no prompt can hang.
  if ! git -C "$root" diff --quiet "$old" HEAD -- plugins/crew/.claude-plugin/plugin.json &&
    command -v claude >/dev/null 2>&1 &&
    claude plugin list --json </dev/null 2>/dev/null | grep -q '"crew@crew"'; then
    if claude plugin marketplace update crew </dev/null >/dev/null 2>&1 &&
      claude plugin update crew@crew </dev/null >/dev/null 2>&1; then
      echo "crew: the crew plugin updated; sessions already open load it after a restart"
    else
      echo "crew: could not refresh the crew plugin, run: claude plugin marketplace update crew && claude plugin update crew@crew" >&2
    fi
  fi
  # The pull replaced this very file (git swaps in a new inode): run the new launcher with the same
  # arguments, so the old text is never read again. CREW_NO_UPDATE stops it from updating a second time.
  CREW_NO_UPDATE=1 exec "$self" "$@"
}

# issue-flow@crew became crew@crew in 3.0.0. The launcher that pulls that change is the old one,
# and it execs this one with CREW_NO_UPDATE=1, so update() never sees the pull: this runs once per
# managed clone instead, whatever CREW_NO_UPDATE says, and crew.migrated in the clone's git config
# remembers it. Same calls as install.sh: install before uninstall, marketplace update, never add.
migrate() {
  [ "$root" = "$HOME/.local/share/crew" ] || return 0
  [ -z "$(git -C "$root" config --get crew.migrated 2>/dev/null)" ] || return 0
  command -v claude >/dev/null 2>&1 || return 0
  # a failed list sets nothing, so the next launch retries; once it answered, the flag goes before
  # the calls, so a terminal started meanwhile does not migrate twice; no retry, the warning says how
  l=$(claude plugin list --json </dev/null 2>/dev/null) || return 0
  git -C "$root" config crew.migrated 3.0.0 2>/dev/null || return 0
  case $l in *'"issue-flow@crew"'*) ;; *) return 0 ;; esac
  if claude plugin marketplace update crew </dev/null >/dev/null 2>&1 &&
    { case $l in *'"crew@crew"'*) ;; *) claude plugin install crew@crew </dev/null >/dev/null 2>&1 ;; esac; } &&
    claude plugin uninstall issue-flow@crew </dev/null >/dev/null 2>&1; then
    echo "crew: issue-flow@crew replaced by crew@crew, the commands are now /crew:*; sessions already open load it after a restart"
  else
    echo "crew: could not replace issue-flow@crew, run: claude plugin marketplace update crew && claude plugin install crew@crew && claude plugin uninstall issue-flow@crew" >&2
  fi
}
update "$@"
migrate

# cd into the worktree of profile <name>: <main checkout>/.claude/worktrees/<name>, at $PWD's subdirectory
# when the worktree has it. The first launch creates it detached at origin/HEAD (HEAD without one); later
# launches reuse it untouched: it may hold the session's branch with work in progress. Non-zero on failure.
# ponytail: .claude/worktrees/ because Claude Code exempts it from its protected paths, and .git/ is one.
into_worktree() { # <name>
  common=$(git rev-parse --path-format=absolute --git-common-dir) &&
    sub=$(git rev-parse --show-prefix) &&
    top=$(git worktree list --porcelain | sed -n '1s/^worktree //p') &&
    [ -n "$top" ] || return 1
  wt="$top/.claude/worktrees/$1"
  if [ ! -e "$wt" ]; then
    # the main checkout's git status must not list the worktree; a last line without its newline keeps its own
    x="$common/info/exclude"
    grep -qxF /.claude/worktrees/ "$x" 2>/dev/null ||
      { mkdir -p "$common/info" && { [ ! -s "$x" ] || [ -z "$(tail -c 1 "$x")" ] || echo >>"$x"; } &&
        echo /.claude/worktrees/ >>"$x"; } || return 1
    fetch5 . || :   # offline: the origin/HEAD already here will do, the skills fetch before branching
    ref=origin/HEAD
    git rev-parse -q --verify "$ref^{commit}" >/dev/null || ref=HEAD
    git rev-parse -q --verify "$ref^{commit}" >/dev/null || return 1   # no commit: the caller says so
    # -f: a worktree deleted by hand, without git worktree remove, is still registered; git's reason stays on stderr
    git worktree add -q -f --detach "$wt" "$ref" >/dev/null || return 1
  else
    git worktree repair "$wt" >/dev/null 2>&1 || :   # a moved project: the worktree's links still name the old path
  fi
  [ "$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null)" = "$wt" ] && cd "$wt" || return 1
  sub=${sub%/}
  if [ -n "$sub" ] && [ -d "$sub" ]; then cd "./$sub"; fi   # ./: never through an exported CDPATH
}

if [ "${1:-}" = run ]; then
  n="${2:-}"
  f="$crewdir/$n.md"
  [ -n "$n" ] && [ -f "$f" ] || { echo "crew: no profile '$n' in $crewdir" >&2; exit 1; }
  m=$(cat "${f%.md}.model" 2>/dev/null | tr -d '[:space:]')
  if [ -f "${f%.md}.worktree" ] && [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = true ]; then
    # no worktree, no session: in the main checkout the skills would move it off the target branch
    if ! into_worktree "$n"; then
      if git rev-parse -q --verify HEAD >/dev/null; then
        echo "crew: could not set up the worktree of $n${wt:+ at $wt}, not starting it" >&2
      else
        echo "crew: $n works in its own git worktree, which needs a commit: make the repo's first commit, then run crew again" >&2
      fi
      exit 1
    fi
  fi
  exec claude -n "$n" ${m:+--model "$m"} --append-system-prompt-file "$f"
fi

d=$(CDPATH='' cd -- "${1:-.}" && pwd)
# ponytail: fixed delay, not a lock. The first session may auto-update Claude Code
# and swap the ~/.local/bin/claude symlink; sessions started in that instant get
# "command not found". Raise the delay if an update ever takes longer.
wait=

for f in "$crewdir"/*.md; do
  [ -e "$f" ] || { echo "crew: no profiles in $crewdir" >&2; exit 1; }
  n=$(basename "$f" .md)
  # CREW_DIR in the command: Terminal.app's do script does not pass this process's environment on.
  # The sleep goes before the cd: after it, its `;` would let a failed cd run the session anywhere.
  cmd="${wait}cd '$d' && CREW_DIR='$crewdir' CREW_NO_UPDATE=1 '$self' run '$n'"
  case "$(uname -s)" in
    Darwin)
      osascript -e "tell app \"Terminal\" to do script \"$cmd\"" >/dev/null
      ;;
    *)
      for t in "$TERMINAL" x-terminal-emulator gnome-terminal konsole kitty wezterm alacritty xterm; do
        [ -n "$t" ] || continue
        command -v "$t" >/dev/null 2>&1 || continue
        case "$t" in
          gnome-terminal) "$t" -- sh -c "$cmd; exec \$SHELL" & ;;
          *)              "$t" -e sh -c "$cmd; exec \$SHELL" & ;;
        esac
        break
      done
      ;;
  esac
  wait='sleep 5; '
done
